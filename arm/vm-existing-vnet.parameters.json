{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vmName": { "value": "vm-app-01" },
    "vmSize": { "value": "Standard_D2s_v5" },
    "adminUsername": { "value": "azureadmin" },
    "adminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/rg-security-prod/providers/Microsoft.KeyVault/vaults/kv-secrets-prod"
        },
        "secretName": "vm-local-admin-password"
      }
    },
    "existingVnetResourceGroup": { "value": "rg-network-prod" },
    "existingVnetName": { "value": "vnet-hub-prod" },
    "existingSubnetName": { "value": "snet-servers" },
    "tags": {
      "value": {
        "environment": "prod",
        "owner": "platform-team",
        "deployedWith": "arm"
      }
    }
  }
}
